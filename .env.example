# Copy to .env. Never commit production credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadloop?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/leadloop?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For verification/password reset/invites; only the development server logs links when unset.
RESEND_API_KEY=""
EMAIL_FROM="LeadLoop <no-reply@example.com>"
# Optional free email transport using the existing Notification Service.
# Configure a dedicated LeadLoop application, publish its template slugs,
# and store the API key only in Vercel environment variables (never here).
# Templates must render {{url}} as the destination for an action link.
NOTIFICATION_SERVICE_URL=""
NOTIFICATION_SERVICE_API_KEY=""
NOTIFICATION_TEMPLATE_VERIFICATION=""
NOTIFICATION_TEMPLATE_PASSWORD_RESET=""
NOTIFICATION_TEMPLATE_INVITATION=""

# Phase 4: server-to-server ingestion from Sister's Magical Spoon.
SISTERS_BUSINESS_ID=""
SISTERS_CRM_SECRET=""
